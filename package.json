{
  "name": "@borwood/demoable-react",
  "version": "0.1.0",
  "description": "Optional component inspection and rich contextual explanations for React demos",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "docs/api",
    "docs/images",
    "docs/integration-skills.md",
    "docs/examples.md",
    "demo/App.tsx",
    "demo/app.css",
    "skills/agent",
    "skills/claude"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "npm@11.5.2",
  "peerDependencies": {
    "react": "^18.3.1 || ^19.3.0",
    "react-dom": "^18.3.1 || ^19.3.0"
  },
  "scripts": {
    "typecheck": "npm run skills:check && npm run build:lib && tsc --noEmit",
    "build:lib": "vite build --config vite.library.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "dev": "npm run build:lib && vite --config vite.demo.config.ts --host 127.0.0.1",
    "test:integration": "npm run build:lib && vitest run",
    "test:consumer": "npm run build:lib && node scripts/verify-consumers.mjs",
    "test:browser": "npm run build && node scripts/verify-consumers.mjs --browser",
    "skills:sync": "node scripts/sync-integration-skills.mjs",
    "skills:check": "node scripts/sync-integration-skills.mjs --check"
  },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.3",
    "typescript": "5.9.3",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "jsdom": "26.1.0",
    "@types/node": "22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borwood/demoable-react.git"
  },
  "homepage": "https://github.com/borwood/demoable-react#readme",
  "bugs": {
    "url": "https://github.com/borwood/demoable-react/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  }
}
